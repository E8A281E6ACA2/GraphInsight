# 统一行尾，避免 Windows/macOS 协作时 CRLF/LF 混用污染 git diff。
# 提交入库一律使用 LF；检出时按文本类型自动处理。
* text=auto eol=lf

# 明确以 LF 存储的源码与配置
*.go      text eol=lf
*.py      text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.js      text eol=lf
*.jsx     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.sh      text eol=lf
*.sql     text eol=lf
*.toml    text eol=lf
.gitattributes text eol=lf

# Windows 批处理保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做行尾处理
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.mp4 binary
*.zip binary
